CONFIG_IDF_TARGET="esp32p4"
CONFIG_EXAMPLE_LCD_BUF_COUNT=3
CONFIG_LCD_PIXEL_FORMAT_RGB888=y
CONFIG_COMPILER_ORPHAN_SECTIONS_PLACE=y
CONFIG_ESP32P4_REV_MIN_1=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_FREERTOS_HZ=1000
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
CONFIG_TUSB_PID=0x2987
CONFIG_UAC_AUDIO_ENABLE=n
CONFIG_USB_EXTEND_SCREEN_HEIGHT=452
CONFIG_USB_EXTEND_SCREEN_WIDTH=1280
CONFIG_USB_EXTEND_SCREEN_RX_FRAME_BUFFER_COUNT=12
CONFIG_USB_EXTEND_SCREEN_JPEG_DECODE_RING_COUNT=4
# CONFIG_USB_EXTEND_SCREEN_USB_STABILITY_TEST_MODE is not set
